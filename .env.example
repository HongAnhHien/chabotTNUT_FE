# Frontend (Vite) — sao chép thành .env rồi điền giá trị thật (KHÔNG commit .env)
VITE_API_BASE_URL=http://localhost:8000/api

# Google Maps (để dành cho tính năng bản đồ/ngoại trú WebGIS)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Phân hệ RIAT E-learning (app Next.js chạy riêng). Dev mặc định http://localhost:3001;
# khi triển khai đổi thành domain thật (vd https://elearning.tnut.edu.vn).
VITE_RIAT_ELEARNING_URL=http://localhost:3001
